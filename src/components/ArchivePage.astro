---
import BaseLayout from "@/layouts/BaseLayout.astro";
import PageIntro from "@/components/PageIntro.astro";
import { archiveDate, archivePosts, archiveUrl } from "@/content/archive";
import { pageMeta, type Locale } from "@/content/site";

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const copy =
  locale === "es"
    ? {
        eyebrow: "Archivo",
        title: "El blog original, preservado.",
        lead: "Seis publicaciones históricas sobre datos, tecnología y proyectos personales. No forman parte del enfoque actual de Data Guasu, pero siguen disponibles en sus URLs originales.",
        notice:
          "Cada artículo se mantiene en el idioma en que fue publicado. El contenido es histórico: algunas herramientas, enlaces y detalles técnicos pueden estar desactualizados.",
        read: "Leer artículo",
        languageLabel: "Idioma",
        languages: { es: "Español", en: "Inglés" },
        feed: "Suscribirse por RSS",
      }
    : {
        eyebrow: "Archive",
        title: "The original blog, preserved.",
        lead: "Six historical posts on data, technology, and personal projects. They sit outside Data Guasu’s current focus, but remain available at their original URLs.",
        notice:
          "Each article remains in its original language. This is historical content: some tools, links, and technical details may now be outdated.",
        read: "Read article",
        languageLabel: "Language",
        languages: { es: "Spanish", en: "English" },
        feed: "Subscribe via RSS",
      };
---

<BaseLayout locale={locale} pageKey="archive" {...pageMeta[locale].archive}>
  <PageIntro eyebrow={copy.eyebrow} title={copy.title} lead={copy.lead} />
  <section class="section archive-section">
    <div class="shell">
      <div class="archive-context">
        <p>{copy.notice}</p>
        <a class="text-link" href="/feed.xml">{copy.feed}</a>
      </div>
      <div class="archive-list">
        {
          archivePosts.map((post, index) => (
            <article class="archive-card">
              <div class="archive-card-index">{String(index + 1).padStart(2, "0")}</div>
              <div class="archive-card-main">
                <div class="archive-card-meta">
                  <time datetime={post.publishedDate}>{archiveDate(post, locale)}</time>
                  <span>{post.topic[locale]}</span>
                  <span>
                    {copy.languageLabel}: {copy.languages[post.language]}
                  </span>
                </div>
                <h2>
                  <a href={archiveUrl(post)}>{post.title}</a>
                </h2>
                <p>{post.description[locale]}</p>
                <a class="text-link" href={archiveUrl(post)} lang={post.language}>
                  {copy.read}
                </a>
              </div>
            </article>
          ))
        }
      </div>
    </div>
  </section>
</BaseLayout>
