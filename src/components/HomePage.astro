---
import BaseLayout from "@/layouts/BaseLayout.astro";
import DecisionPanel from "@/components/DecisionPanel.astro";
import ContactBand from "@/components/ContactBand.astro";
import { pageMeta, route, site, type Locale } from "@/content/site";

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const content =
  locale === "es"
    ? {
        eyebrow: site.descriptor,
        title: "Entendé qué impulsa el crecimiento. Invertí con confianza.",
        lead: "Ayudamos a equipos de marketing y crecimiento a medir el impacto real de sus campañas, proyectar retornos y asignar mejor sus presupuestos.",
        primary: "Hablemos de tu medición",
        secondary: "Ver cómo trabajamos",
        decisionsEyebrow: "Las preguntas que importan",
        decisionsTitle: "Mejores decisiones antes de mover el presupuesto.",
        decisionsIntro:
          "El objetivo no es sumar otro dashboard. Es reducir la incertidumbre detrás de decisiones comerciales concretas.",
        questions: [
          "¿Qué canales generan valor incremental?",
          "¿Cuánto podemos invertir manteniendo la rentabilidad?",
          "¿Cuánto valdrán las cohortes actuales?",
          "¿Cómo distribuir el presupuesto del próximo trimestre?",
          "¿Podemos confiar en el ROAS reportado por las plataformas?",
          "¿Qué experimento resolvería la incertidumbre más importante?",
        ],
        servicesEyebrow: "Tres formas de trabajar",
        servicesTitle: "De una pregunta urgente a una capacidad sostenible.",
        serviceLink: "Explorar el alcance",
        experienceEyebrow: "Experiencia representativa",
        experienceTitle: "Problemas complejos, traducidos a decisiones utilizables.",
        experienceBody:
          "Experiencia internacional en gaming, telecomunicaciones y entornos comerciales donde adquisición, producto y finanzas necesitan una lectura común de la performance.",
        experienceItems: [
          "Proyectar ROAS de largo plazo desde señales tempranas de cohortes",
          "Optimizar automáticamente presupuestos y objetivos de ROAS a nivel campaña",
          "Medir y recomendar bajo limitaciones de privacidad móvil",
          "Detectar anomalías antes de que distorsionen el forecast",
        ],
        experienceLink: "Ver experiencia seleccionada",
        industriesEyebrow: "Sectores",
        industriesTitle: "Foco en negocios con inversión digital significativa.",
        industries: [
          "Gaming y apps",
          "Fintech",
          "Telecom",
          "E-commerce",
          "Marketplaces",
          "Suscripciones",
          "Agencias",
        ],
        whyEyebrow: "Por qué Data Guasu",
        whyTitle: "Profundidad técnica con criterio comercial.",
        reasons: [
          {
            title: "Una práctica senior",
            body: "Trabajo directo con quien diseña el enfoque, construye el análisis y acompaña la decisión.",
          },
          {
            title: "Método proporcional",
            body: "La sofisticación se ajusta a la decisión, a la calidad de los datos y al costo de equivocarse.",
          },
          {
            title: "Equipos alineados",
            body: "Un lenguaje común para marketing, finanzas, analytics e ingeniería, con supuestos explícitos.",
          },
        ],
        founderEyebrow: "Consultoría independiente",
        founderTitle: "Liderada por un practicante que conecta modelos y operación.",
        founderBody:
          "Nicolás Escobar es senior data scientist con experiencia internacional en la intersección de marketing, user acquisition y data science. Trabaja desde Paraguay con equipos distribuidos y aporta cerca de siete años de experiencia aplicada en gaming, además de trayectoria en telecomunicaciones.",
        founderFacts: [
          { value: "~7 años", label: "aplicando data science en gaming" },
          { value: "M.S.", label: "en Data Science, Indiana University" },
          { value: "Paraguay", label: "base local, colaboración internacional" },
        ],
        founderLink: "Conocer la práctica",
        linkedinLink: "Ver perfil de LinkedIn",
      }
    : {
        eyebrow: site.descriptor,
        title: "Know what drives growth. Invest with confidence.",
        lead: "We help marketing and growth teams measure incremental campaign impact, forecast returns, and allocate acquisition budgets using their own data.",
        primary: "Discuss your measurement",
        secondary: "See how we work",
        decisionsEyebrow: "Questions that matter",
        decisionsTitle: "Make the decision clearer before moving the budget.",
        decisionsIntro:
          "The goal is not another dashboard. It is less uncertainty behind concrete commercial decisions.",
        questions: [
          "Which channels generate incremental value?",
          "How much can we spend while maintaining profitability?",
          "What will current acquisition cohorts be worth?",
          "How should next quarter’s budget be distributed?",
          "Can we trust platform-reported ROAS?",
          "Which experiment would resolve the most important uncertainty?",
        ],
        servicesEyebrow: "Three ways to work together",
        servicesTitle: "From an urgent question to a durable measurement capability.",
        serviceLink: "Explore the scope",
        experienceEyebrow: "Representative experience",
        experienceTitle: "Complex measurement problems, translated into usable decisions.",
        experienceBody:
          "International experience across gaming, telecommunications, and commercial environments where acquisition, product, and finance need a shared view of performance.",
        experienceItems: [
          "Forecast long-term ROAS from early cohort signals",
          "Automatically optimize campaign-level budgets and ROAS targets",
          "Measure and recommend under mobile privacy limitations",
          "Detect anomalies before they distort the forecast",
        ],
        experienceLink: "See selected experience",
        industriesEyebrow: "Industries",
        industriesTitle: "Focused on businesses with meaningful digital acquisition spend.",
        industries: [
          "Gaming & apps",
          "Fintech",
          "Telecom",
          "E-commerce",
          "Marketplaces",
          "Subscriptions",
          "Agencies",
        ],
        whyEyebrow: "Why Data Guasu",
        whyTitle: "Technical depth with commercial judgment.",
        reasons: [
          {
            title: "Senior practice",
            body: "Work directly with the person shaping the approach, building the analysis, and supporting the decision.",
          },
          {
            title: "Proportionate method",
            body: "Sophistication is matched to the decision, the available data, and the cost of getting it wrong.",
          },
          {
            title: "Aligned teams",
            body: "A shared language for marketing, finance, analytics, and engineering, with assumptions made explicit.",
          },
        ],
        founderEyebrow: "Independent consultancy",
        founderTitle: "Led by a practitioner who connects models with marketing operations.",
        founderBody:
          "Nicolás Escobar is a senior data scientist with international experience at the intersection of marketing, user acquisition, and data science. Based in Paraguay, he works with distributed teams and brings about seven years of applied experience in gaming, alongside earlier telecommunications experience.",
        founderFacts: [
          { value: "~7 years", label: "applying data science in gaming" },
          { value: "M.S.", label: "in Data Science, Indiana University" },
          { value: "Paraguay", label: "local base, international collaboration" },
        ],
        founderLink: "Meet the practice",
        linkedinLink: "View LinkedIn profile",
      };
---

<BaseLayout locale={locale} pageKey="home" {...pageMeta[locale].home}>
  <section class="hero section-dark">
    <div class="shell hero-grid">
      <div>
        <p class="eyebrow">{content.eyebrow}</p>
        <h1>{content.title}</h1>
        <p class="hero-lead">{content.lead}</p>
        <div class="hero-actions">
          <a class="button" href={route(locale, "contact")}
            >{content.primary}<span aria-hidden="true">↗</span></a
          >
          <a class="button button-ghost" href={route(locale, "services")}>{content.secondary}</a>
        </div>
      </div>
      <DecisionPanel locale={locale} />
    </div>
  </section>

  <section class="section" aria-labelledby="decisions-title">
    <div class="shell">
      <div class="section-heading">
        <div>
          <p class="eyebrow">{content.decisionsEyebrow}</p>
          <h2 id="decisions-title">{content.decisionsTitle}</h2>
        </div>
        <p>{content.decisionsIntro}</p>
      </div>
      <div class="decision-questions">
        {
          content.questions.map((question, index) => (
            <div class="question-row">
              <>
                <span>0{index + 1}</span>
                <strong>{question}</strong>
                <span aria-hidden="true">↗</span>
              </>
            </div>
          ))
        }
      </div>
    </div>
  </section>

  <section class="section section-dark" aria-labelledby="services-title">
    <div class="shell">
      <div class="section-heading">
        <div>
          <p class="eyebrow">{content.servicesEyebrow}</p>
          <h2 id="services-title">{content.servicesTitle}</h2>
        </div>
      </div>
      <div class="services-grid">
        {
          site.services[locale].map((service) => (
            <article class="service-card">
              <>
                <span class="number">{service.number}</span>
                <h3>{service.title}</h3>
                <p>{service.summary}</p>
                <a class="text-link" href={`${route(locale, "services")}#${service.id}`}>
                  {content.serviceLink}
                </a>
              </>
            </article>
          ))
        }
      </div>
    </div>
  </section>

  <section class="section" aria-labelledby="experience-title">
    <div class="shell experience-highlight">
      <div class="experience-copy">
        <p class="eyebrow">{content.experienceEyebrow}</p>
        <h2 id="experience-title">{content.experienceTitle}</h2>
        <p>{content.experienceBody}</p>
        <a class="text-link" href={route(locale, "experience")}>{content.experienceLink}</a>
      </div>
      <div class="experience-ledger">
        {
          content.experienceItems.map((item) => (
            <div>
              <p>{item}</p>
            </div>
          ))
        }
      </div>
    </div>
  </section>

  <section class="section-tight">
    <div class="shell">
      <div class="section-heading">
        <div>
          <p class="eyebrow">{content.industriesEyebrow}</p><h2>{content.industriesTitle}</h2>
        </div>
      </div>
      <div class="industry-strip">
        <ul class="industry-list">{content.industries.map((industry) => <li>{industry}</li>)}</ul>
      </div>
    </div>
  </section>

  <section class="section" aria-labelledby="why-title">
    <div class="shell">
      <div class="section-heading">
        <div>
          <p class="eyebrow">{content.whyEyebrow}</p><h2 id="why-title">{content.whyTitle}</h2>
        </div>
      </div>
      <div class="principles-grid">
        {
          content.reasons.map((reason) => (
            <article class="principle">
              <>
                <h3>{reason.title}</h3>
                <p>{reason.body}</p>
              </>
            </article>
          ))
        }
      </div>
    </div>
  </section>

  <section class="section section-dark" aria-labelledby="founder-title">
    <div class="shell founder-grid">
      <div class="founder-copy">
        <p class="eyebrow">{content.founderEyebrow}</p>
        <h2 id="founder-title">{content.founderTitle}</h2>
        <p>{content.founderBody}</p>
        <div class="proof-points">
          {
            content.founderFacts.map((fact) => (
              <div>
                <>
                  <strong>{fact.value}</strong>
                  <span>{fact.label}</span>
                </>
              </div>
            ))
          }
        </div>
        <div class="hero-actions">
          <a class="button button-light" href={route(locale, "about")}>{content.founderLink}</a>
          <a
            class="button button-ghost"
            href={site.linkedinUrl}
            target="_blank"
            rel="noopener noreferrer"
            >{content.linkedinLink}<span aria-hidden="true">↗</span><span class="sr-only"
              >{locale === "es" ? "(abre en una nueva pestaña)" : "(opens in a new tab)"}</span
            ></a
          >
        </div>
      </div>
    </div>
  </section>

  <ContactBand locale={locale} />
</BaseLayout>
