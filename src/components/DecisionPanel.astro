---
import type { Locale } from "@/content/site";

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const labels =
  locale === "es"
    ? {
        eyebrow: "De evidencia a decisión",
        question: "¿Qué retorno incremental generó la campaña?",
        plotAxis: "Retorno acumulado",
        plotObserved: "Con campaña",
        plotCounterfactual: "Sin campaña",
        plotLaunch: "Inicio de campaña",
        plotLift: "Retorno incremental",
        plotTime: "Tiempo",
        plotLabel:
          "Gráfico ilustrativo que compara el retorno observado con el retorno esperado sin campaña. El área entre las curvas representa el retorno incremental.",
        evidence: "Diseño",
        evidenceDetail: "Test · holdout · causal",
        forecast: "Contrafactual",
        forecastDetail: "Escenario sin campaña",
        decision: "Decisión",
        decisionDetail: "Escalar · pausar · reasignar",
        note: "El contrafactual separa el efecto de la campaña del crecimiento que habría ocurrido igualmente.",
      }
    : {
        eyebrow: "From evidence to decision",
        question: "What incremental return did the campaign generate?",
        plotAxis: "Cumulative return",
        plotObserved: "With campaign",
        plotCounterfactual: "Without campaign",
        plotLaunch: "Campaign starts",
        plotLift: "Incremental return",
        plotTime: "Time",
        plotLabel:
          "Illustrative chart comparing observed return with the return expected without the campaign. The area between the curves represents incremental return.",
        evidence: "Design",
        evidenceDetail: "Test · holdout · causal",
        forecast: "Counterfactual",
        forecastDetail: "No-campaign baseline",
        decision: "Decision",
        decisionDetail: "Scale · pause · reallocate",
        note: "The counterfactual separates campaign impact from growth that would have happened anyway.",
      };
---

<div class="decision-panel" aria-label={labels.eyebrow}>
  <div class="panel-topline">
    <span>{labels.eyebrow}</span>
    <span aria-hidden="true">DG—01</span>
  </div>
  <p class="panel-question">{labels.question}</p>
  <div class="incrementality-plot" role="img" aria-label={labels.plotLabel}>
    <div class="incrementality-legend" aria-hidden="true">
      <span><i class="legend-line legend-line-observed"></i>{labels.plotObserved}</span>
      <span><i class="legend-line legend-line-counterfactual"></i>{labels.plotCounterfactual}</span>
    </div>
    <div class="incrementality-canvas" aria-hidden="true">
      <span class="incrementality-axis">{labels.plotAxis}</span>
      <svg viewBox="0 0 560 150">
        <defs>
          <linearGradient id="incremental-fill" x1="0" y1="0" x2="1" y2="0">
            <stop offset="0" stop-color="#58d4ed" stop-opacity="0"></stop>
            <stop offset="1" stop-color="#58d4ed" stop-opacity="0.28"></stop>
          </linearGradient>
        </defs>
        <g class="incrementality-grid">
          <path d="M24 20H548M24 58H548M24 96H548M24 134H548"></path>
          <path d="M24 20V134M155 20V134M286 20V134M417 20V134M548 20V134"></path>
        </g>
        <path
          class="incrementality-area"
          d="M246 104C296 86 346 67 399 54C454 42 502 32 548 26L548 69C500 76 452 82 399 89C346 95 296 101 246 104Z"
        ></path>
        <path
          class="incrementality-line incrementality-line-observed"
          d="M24 132C77 125 129 119 180 113C207 110 229 107 246 104C296 86 346 67 399 54C454 42 502 32 548 26"
        ></path>
        <path
          class="incrementality-line incrementality-line-counterfactual"
          d="M24 132C77 125 129 119 180 113C207 110 229 107 246 104C296 101 346 95 399 89C452 82 500 76 548 69"
        ></path>
        <line class="campaign-launch" x1="246" y1="18" x2="246" y2="136"></line>
        <circle class="campaign-launch-point" cx="246" cy="104" r="5"></circle>
        <path class="incrementality-bracket" d="M535 29H548M548 29V66M535 66H548"></path>
      </svg>
      <span class="incrementality-lift">{labels.plotLift}</span>
    </div>
    <div class="incrementality-footer" aria-hidden="true">
      <span>{labels.plotLaunch}</span>
      <span>{labels.plotTime} →</span>
    </div>
  </div>
  <ol class="decision-steps">
    <li>
      <span class="step-number">01</span>
      <strong>{labels.evidence}</strong>
      <small>{labels.evidenceDetail}</small>
    </li>
    <li>
      <span class="step-number">02</span>
      <strong>{labels.forecast}</strong>
      <small>{labels.forecastDetail}</small>
    </li>
    <li>
      <span class="step-number">03</span>
      <strong>{labels.decision}</strong>
      <small>{labels.decisionDetail}</small>
    </li>
  </ol>
  <p class="panel-note"><span aria-hidden="true">●</span> {labels.note}</p>
</div>
